# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API).
# .env.local is git-ignored, so these never get committed.
#
# Only use the "anon" / "publishable" key here — it is safe in the browser
# because Row Level Security decides what it can do.
# NEVER put the service_role / secret key in this app.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
