# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Connect → App Frameworks → React / Vite).
# .env.local is git-ignored, so these never get committed.
#
# Only use the publishable (or older "anon") key here — it is safe in the browser
# because Row Level Security decides what it can do.
# NEVER put a secret / service_role key in this app.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
